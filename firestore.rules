rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile and settings
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // ⚠️ DEMO-ONLY, NOT PRODUCTION-SAFE ⚠️
      // Bookings (guest UID, dates, payment amounts, confirmation code) are
      // PUBLICLY READABLE so a static admin dashboard with no login can show
      // every booking live. This was a deliberate tradeoff for a fast school
      // project demo — anyone with the Firebase project config (which is
      // not secret and ships inside the Android APK) can read every user's
      // booking history. Writes still require the real account owner.
      // TO LOCK THIS BACK DOWN before handling any real user's data, revert
      // "allow read: if true" below to:
      //   allow read, write: if request.auth != null && request.auth.uid == uid;
      match /bookings/{bookingId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Users can only read/write their own notifications
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Users can only read/write their own chat history
      match /chatMessages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Mirror of the /users/{uid}/bookings rule above, specifically so the
    // admin dashboard's collectionGroup("bookings") query is authorized —
    // Firestore only grants a collection-group query access via a
    // recursive wildcard match, not the fixed-depth rule nested under
    // /users/{uid} (that one only covers direct-path reads/writes).
    match /{path=**}/bookings/{bookingId} {
      allow read: if true;
    }

    // Host properties: owner can create/update/delete their own;
    // any signed-in user can read, so the guest hotel feed can show
    // every host's active listings.
    match /properties/{propertyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null && (
                    request.auth.uid == resource.data.hostUid
                    // Any signed-in guest may bump bookingCount when they book
                    // this property — and only bookingCount, nothing else —
                    // since bookings live under the guest's own subcollection
                    // and the host has no other way to learn a count changed.
                    || request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['bookingCount'])
                  );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.hostUid;
    }

    // Live room-availability counters, one doc per hotel (catalog hotel id
    // or host property id — same shape either way). Reads are public so
    // the admin dashboard can show live counts without signing in; writes
    // still require a real signed-in user (booking/cancelling/hosting all
    // already require an account).
    match /roomAvailability/{hotelId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
